flowchart TB
    subgraph App["Application (composition root)"]
        AuthzImpl["Authorizer impl<br/>(app policy)"]
        OG["ObserverGroup<br/>(parallel fan-out)"]
        Wire["Service wiring"]
    end

    subgraph Peers["Peer modules — each depends only on core-module"]
        direction LR
        UsersM["users-module"]
        TagsM["tags-module"]
        ContactsM["contacts-module"]
        AuditM["audit-module<br/>(Observer impl)"]
    end

    subgraph CoreM["core-module — shared contracts + helpers"]
        direction TB
        Authz["Authorizer<br/>(interface)"]
        Mut["MutationObserver<br/>(interface)"]
        Ent["Entity<br/>(interface)"]
        TX["txhelper.Run<br/>(tx + post-commit dispatch)"]
        Octx["opctx<br/>(actor / assumed-actor / request-id)"]
    end

    Wire -->|injects Authorizer + ObserverGroup| UsersM
    Wire -->|injects| TagsM
    Wire -->|injects| ContactsM
    Wire -->|composes| AuditM
    AuditM -->|plugs into| OG
    AuthzImpl -.implements.-> Authz
    AuditM -.implements.-> Mut
    UsersM --- CoreM
    TagsM --- CoreM
    ContactsM --- CoreM
    AuditM --- CoreM

    classDef iface fill:#eef,stroke:#447,stroke-width:1px;
    classDef helper fill:#efe,stroke:#474,stroke-width:1px;
    class Authz,Mut,Ent iface;
    class TX,Octx,OG helper;
