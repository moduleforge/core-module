{
  "$description": "Raw / base font-primitive tier: family stacks plus the literal size / weight / line-height / tracking ramps the typography tier composes from. NOTE: mod-core/gui/.ladle/styles.css does NOT define --font-sans / --font-mono literals itself (it maps @theme --font-sans to var(--font-sans), whose value comes from Tailwind v4 / shadcn defaults). The stacks below capture standard Tailwind v4 system-font equivalents so the token source is self-contained; see tokens/README.md.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["ui-sans-serif", "system-ui", "sans-serif", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"],
        "$description": "Default UI sans stack (Tailwind v4 system default)."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"],
        "$description": "Default monospace stack (Tailwind v4 system default)."
      }
    },
    "size": {
      "$description": "Literal font-size ramp (rem). The typography tier aliases these per level.",
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "1.875rem" },
      "4xl": { "$type": "dimension", "$value": "2.25rem" },
      "5xl": { "$type": "dimension", "$value": "3rem" }
    },
    "weight": {
      "$description": "Literal font-weight ramp.",
      "normal": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "line-height": {
      "$description": "Literal unitless line-height ramp.",
      "tight": { "$type": "number", "$value": 1.1 },
      "snug": { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.4 },
      "relaxed": { "$type": "number", "$value": 1.5 }
    },
    "tracking": {
      "$description": "Literal letter-spacing ramp (em).",
      "tighter": { "$type": "dimension", "$value": "-0.02em" },
      "tight": { "$type": "dimension", "$value": "-0.01em" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.01em" }
    }
  }
}
